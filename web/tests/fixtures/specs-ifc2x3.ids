<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info><title>IFC2X3 regression</title></info>
  <specifications>
    <specification name="wall name attribute" ifcVersion="IFC2X3">
      <applicability minOccurs="1" maxOccurs="unbounded"><entity><name><simpleValue>IFCWALL</simpleValue></name></entity></applicability>
      <requirements><attribute><name><simpleValue>Name</simpleValue></name><value><simpleValue>W1</simpleValue></value></attribute></requirements>
    </specification>
    <specification name="no doors allowed" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="0"><entity><name><simpleValue>IFCDOOR</simpleValue></name></entity></applicability>
      
    </specification>
    <specification name="no columns allowed" ifcVersion="IFC2X3">
      <applicability minOccurs="0" maxOccurs="0"><entity><name><simpleValue>IFCCOLUMN</simpleValue></name></entity></applicability>
      
    </specification>
  </specifications>
</ids>
