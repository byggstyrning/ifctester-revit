{
  "name": "ifctester-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json && svelte-check && biome lint . && node scripts/check-versions.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist",
    "check:versions": "node scripts/check-versions.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@internationalized/date": "^3.8.1",
    "@lucide/svelte": "^0.515.0",
    "@playwright/test": "~1.56.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.4",
    "bits-ui": "^2.8.10",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "sass-embedded": "^1.89.0",
    "svelte": "^5.55.8",
    "svelte-check": "^4.0.0",
    "svelte-sonner": "^1.0.5",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.2",
    "typescript": "^5.8.3",
    "vite": "^6.4.2"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "hyperid": "^4.0.0",
    "lucide-svelte": "^0.542.0",
    "socket.io-client": "^4.8.1",
    "svelecte": "^5.2.0",
    "svelte-spa-router": "^4.0.1"
  },
  "overrides": {
    "devalue": "5.9.4"
  }
}
